  "dailyInsightLabel": "क्या आपको पता है?",
  "insightMenstrual1": "अभी आपके गर्भाशय की परत झड़ रही है — ज़्यादातर पीरियड 3 से 7 दिन चलते हैं, और यह पूरी तरह सामान्य है।",
  "insightMenstrual2": "हरी पत्तेदार सब्ज़ियाँ और दालें जैसे आयरन से भरपूर खाने इस हफ़्ते होने वाली कमी की भरपाई में मदद कर सकते हैं।",
  "insightFollicular1": "एस्ट्रोजन बढ़ रहा है, और बहुत से लोग इसी के आसपास ज़्यादा ऊर्जा और बेहतर ध्यान महसूस करते हैं।",
  "insightFollicular2": "आपका शरीर एक अंडाणु छोड़ने की तैयारी कर रहा है — यह चरण एक हफ़्ते से लेकर कुछ हफ़्तों तक चल सकता है।",
  "insightFertile1": "यह आपकी अनुमानित उर्वर अवधि है — ओव्यूलेशन के आसपास के वे दिन जब आम समय-चक्र के हिसाब से गर्भधारण की संभावना सबसे ज़्यादा होती है।",
  "insightFertile2": "कुछ लोग ओव्यूलेशन के आसपास बेसल शारीरिक तापमान में हल्की बढ़ोतरी या सर्वाइकल म्यूकस में बदलाव महसूस करते हैं।",
  "insightLuteal1": "ओव्यूलेशन के बाद प्रोजेस्टेरोन बढ़ता है — मनोदशा में बदलाव या पेट फूलने जैसे पीएमएस लक्षण अक्सर इसी दौरान दिखते हैं।",
  "insightLuteal2": "अगर गर्भ नहीं ठहरा है, तो इस चरण के आख़िर में हार्मोन का स्तर गिरता है और अगला पीरियड शुरू हो जाता है।",
  "insightUnknown1": "चक्र की लंबाई हर व्यक्ति में काफ़ी अलग होती है — 21 से 35 दिन के बीच कुछ भी सामान्य माना जाता है।",
  "insightsPhaseTipsTitle": "इस चरण में अच्छा लग सकता है",
  "tipFitnessLabel": "गतिविधि",
  "tipNutritionLabel": "पोषण",
  "tipFitnessMenstrual": "अभी हल्की गतिविधि — टहलना, स्ट्रेचिंग या आरामदेह योग — तेज़ कसरत से बेहतर लग सकती है।",
  "tipFitnessFollicular": "इस चरण में ऊर्जा अक्सर बढ़ती है — कुछ नई कसरत आज़माने या थोड़ा ज़्यादा ज़ोर लगाने के लिए अच्छा समय।",
  "tipFitnessFertile": "बहुत से लोग यहाँ ख़ुद को सबसे ज़्यादा ऊर्जावान पाते हैं — अगर मन हो तो ज़्यादा तीव्रता वाली कसरत के लिए यह अच्छा चरण है।",
  "tipFitnessLuteal": "अगर इस चरण के बाद वाले दिनों में ऊर्जा घटे, तो कम तीव्रता वाली स्ट्रेंथ ट्रेनिंग या तैराकी ज़्यादा टिकाऊ लग सकती है।",
  "tipFitnessUnknown": "आज जो भी हरकत अच्छी लगे, वही अच्छा चुनाव है — हर दिन के लिए कोई एक \"सही\" रूटीन नहीं होता।",
  "tipNutritionMenstrual": "हरी पत्तेदार सब्ज़ियाँ, दालें और लाल मांस जैसे आयरन से भरपूर खाने इस हफ़्ते होने वाली कमी की भरपाई में मदद कर सकते हैं।",
  "tipNutritionFollicular": "ऊर्जा बढ़ने के साथ हल्का, ताज़ा खाना अक्सर रास आता है — पर इस चरण में खाने का कोई एक \"सही\" तरीक़ा नहीं है।",
  "tipNutritionFertile": "पर्याप्त पानी और संतुलित खाना इस ज़्यादा सक्रिय लगने वाले चरण में ऊर्जा बनाए रखने में मदद करते हैं।",
  "tipNutritionLuteal": "यहाँ खाने की तलब बदल सकती है — जटिल कार्बोहाइड्रेट और मेवे व डार्क चॉकलेट जैसे मैग्नीशियम-युक्त खाने आम पसंद हैं।",
  "tipNutritionUnknown": "जब तक चरण साफ़ न हो, संतुलित और नियमित खाना एक भरोसेमंद विकल्प है।",
