  "importSkipped": "{count, plural, one{{count} வரிசையைப் படிக்க முடியவில்லை; அது விடப்படும்} other{{count} வரிசைகளைப் படிக்க முடியவில்லை; அவை விடப்படும்}}",
  "importConfirm": "என் வரலாற்றில் சேர்க்கவும்",
  "importMergeNote": "இறக்குமதி செய்யப்பட்ட நாட்கள் இணைக்கப்படும். Vera-வில் நீங்கள் ஏற்கெனவே பதிவு செய்த நாட்கள் அப்படியே இருக்கும்.",
