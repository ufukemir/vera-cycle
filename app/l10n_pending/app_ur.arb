  "tipDetailGeneralHeading": "عمومی تجاویز",
  "tipDetailDisclaimer": "یہ عام معلومات ہیں، ذاتی طبی مشورہ نہیں۔ ہر جسم کا ردِعمل مختلف ہوتا ہے، اور یہاں دی گئی کسی بھی تجویز سے زیادہ اہم آپ کی اپنی کیفیت ہے۔ اگر کوئی بات پریشان کرے تو ڈاکٹر سے بات کریں۔",
  "phaseExplainerMenstrual": "بچہ دانی کی اندرونی تہہ گرنے کے ساتھ خون آ رہا ہے۔ ایسٹروجن اور پروجیسٹرون سائیکل کی سب سے نچلی سطح پر ہیں، اسی لیے پہلے دنوں میں بہت سے لوگ زیادہ تھکن اور اندر کی طرف سمٹنے کا احساس رکھتے ہیں۔ مروڑ بچہ دانی کے سکڑنے سے ہوتے ہیں۔ خون آنے سے آئرن بھی کم ہوتا ہے — تھکن کی ایک وجہ یہ بھی ہے۔",
  "phaseExplainerFollicular": "خون آنا رکنے کے بعد ایسٹروجن دوبارہ بڑھنے لگتا ہے۔ زیادہ تر لوگ توانائی، مزاج اور قوتِ برداشت کو واپس آتا محسوس کرتے ہیں۔ بیضہ دانیوں میں فولیکل پک رہے ہوتے ہیں؛ جسم اگلی بیضہ ریزی کی تیاری کر رہا ہوتا ہے۔",
  "phaseExplainerFertile": "ایسٹروجن اپنی بلند ترین سطح کے قریب ہے اور اِنہی دنوں میں بیضہ ریزی متوقع ہے۔ بچہ دانی کے منہ کی رطوبت عموماً شفاف اور پھسلنی ہو جاتی ہے، کچھ لوگ جنسی خواہش میں اضافہ محسوس کرتے ہیں، اور کچھ کو ایک طرف مختصر سی ٹیس ہوتی ہے۔ توانائی اکثر سائیکل کی بلند ترین سطح پر ہوتی ہے۔",
  "phaseExplainerLuteal": "بیضہ ریزی کے بعد پروجیسٹرون بڑھتا ہے، پھر ماہواری قریب آتے ہی تیزی سے گر جاتا ہے۔ یہ گراوٹ پی ایم ایس کی علامات پیدا کر سکتی ہے: اپھارہ، چھاتی میں حساسیت، بھوک میں تبدیلی، نیند کا ٹوٹنا اور مزاج کا بدلنا۔ جسم کا درجۂ حرارت تھوڑا بلند رہتا ہے۔",
  "phaseExplainerUnknown": "یہ بتانے کے لیے ابھی کافی اندراج نہیں کہ آپ کون سے مرحلے میں ہیں۔ Vera کوئی مرحلہ گھڑنے کے بجائے یہ کہہ دینا بہتر سمجھتی ہے۔ چند سائیکل درج ہو جانے پر یہ حصہ آپ ہی کے ڈیٹا سے بھر جائے گا — تب تک نیچے دی گئی تجاویز عام ہیں جو کسی بھی وقت کام آتی ہیں۔",
  "tipFitnessDetailMenstrual": "پہلے دنوں میں سخت ورزش زیادہ تر لوگوں کو راس نہیں آتی، اور یہ نظم و ضبط کا مسئلہ نہیں — توانائی واقعی کم ہوتی ہے۔ چہل قدمی، ہلکی اسٹریچنگ، آرام دہ یوگا اور سانس کی مشقیں خون کی روانی بہتر کرتی ہیں اور مروڑ کی شدت کم کر سکتی ہیں۔ اگر طبیعت اچھی ہو تو سخت سیشن سے بچنے کی کوئی وجہ نہیں: خون آنا ورزش چھوڑنے کی وجہ نہیں۔ ایک عملی بات: زیادہ بہاؤ والے دنوں میں لمبے اور تھکا دینے والے سیشن تھکن بڑھا سکتے ہیں، اس لیے جسم اصل میں جو کہے اُسی کے مطابق ترتیب دیں۔",
  "tipFitnessDetailFollicular": "ایسٹروجن بڑھنے کے ساتھ زیادہ تر لوگ خود کو زیادہ مضبوط اور زیادہ سہار لینے والا محسوس کرتے ہیں؛ عموماً یہی سائیکل کا بہترین حصہ ہوتا ہے کہ کچھ نیا شروع کیا جائے، وزن بڑھایا جائے یا رفتار تیز کی جائے۔ پٹھوں کی مرمت بھی یہاں نسبتاً بہتر ہوتی ہے۔ پھر بھی بتدریج بڑھائیں: زیادہ توانائی کا مطلب چوٹ کا خطرہ صفر ہونا نہیں۔",
  "tipFitnessDetailFertile": "توانائی اور جوش عموماً اپنی بلند ترین سطح پر ہوتے ہیں، اس لیے سخت سیشن اکثر اچھے رہتے ہیں۔ کچھ لوگوں کے جوڑ بیضہ ریزی کے آس پاس تھوڑے ڈھیلے ہوتے ہیں، اس لیے تیزی سے رخ بدلنے والے کھیلوں کے لیے لمبا وارم اپ سمجھ داری ہے۔ پیٹ کی ایک طرف مختصر سی ٹیس عام ہے — لیکن اگر یہ شدید ہو یا برقرار رہے تو آرام کریں اور ڈاکٹر سے رجوع کریں۔",
  "tipFitnessDetailLuteal": "ماہواری قریب آتے ہی توانائی گر سکتی ہے، اتنی ہی محنت پر دل کی دھڑکن زیادہ رہ سکتی ہے، اور بحالی میں زیادہ وقت لگ سکتا ہے۔ یہ ایک متوقع اتار چڑھاؤ ہے، زوال نہیں۔ درمیانے سیشن، قوت بڑھانے والی ورزش کی ذرا ہلکی شکل، اور چہل قدمی یہاں عموماً زیادہ نبھتی ہے۔ اپھارے اور چھاتی کی حساسیت میں سہارا دینے والی برا اور لمبا وارم اپ واقعی فرق ڈالتے ہیں۔",
  "tipFitnessDetailUnknown": "مرحلہ معلوم نہ ہو تب بھی حرکت ہر وقت مفید ہے: ہفتے کے زیادہ تر دنوں میں پھیلی ہوئی معتدل سرگرمی کبھی کبھار کے بہت سخت سیشن سے بہتر ہے۔ اپنی کیفیت کے مطابق ترتیب دیں — تھکن والے دنوں میں چہل قدمی بھی شمار ہوتی ہے۔ چند سائیکل درج ہو جانے پر یہاں مرحلے کے مطابق تجاویز نظر آئیں گی۔",
  "tipNutritionDetailMenstrual": "خون آنے سے آئرن کم ہوتا ہے؛ سرخ گوشت، دالیں، چنے، گہرے ہرے پتوں والی سبزیاں اور گڑ کا شیرہ اس کی تلافی میں مدد دیتے ہیں۔ پودوں والا آئرن وٹامن C کے ساتھ نمایاں طور پر بہتر جذب ہوتا ہے — دال پر لیموں نچوڑنا اس کا سب سے عملی طریقہ ہے۔ کھانے کے ساتھ چائے اور کافی آئرن کا جذب کم کرتی ہیں، اس لیے اُن کے درمیان ایک گھنٹے کا وقفہ کافی ہے۔ خوب پانی پینا خون آنے کے دنوں کی تھکن اور سر درد میں کمی لا سکتا ہے۔",
  "tipNutritionDetailFollicular": "توانائی واپس آنے کے ساتھ جسم دوبارہ بننے کے موڈ میں ہوتا ہے: مناسب پروٹین، ثابت اناج اور سبزیاں اِس میں مدد دیتی ہیں۔ خون آنے کے بعد آئرن کے ذخائر دوبارہ بھرتے رہنا بھی سمجھ داری ہے۔ اِس مرحلے میں کھانا نہ چھوڑنا عموماً آسان ہوتا ہے، اور اس سے اگلے مرحلے کی بھوک کے اتار چڑھاؤ میں زیادہ توازن کے ساتھ داخل ہونا ممکن ہوتا ہے۔",
  "tipNutritionDetailFertile": "یہاں کسی خاص غذا کی ضرورت نہیں؛ متوازن کھانا اور مناسب پانی ہی سب سے زیادہ کام آتے ہیں۔ کچھ لوگوں کو اپھارہ محسوس ہوتا ہے، جو عموماً ہارمونی اور عارضی ہوتا ہے۔ اگر حمل کا ارادہ ہو تو فولک ایسڈ کے بارے میں ڈاکٹر سے پوچھنے کا یہ مناسب وقت ہے — لیکن یہ اُن سے ہونے والی بات ہے، ایسا مشورہ نہیں جو کسی ایپ کو دینا چاہیے۔",
  "tipNutritionDetailLuteal": "پروجیسٹرون بڑھنے کے ساتھ بھوک کا بڑھ جانا اور میٹھے کی خواہش بہت عام ہے؛ یہ ہارمونی تبدیلی ہے، قوتِ ارادی کا مسئلہ نہیں۔ کھانوں میں پروٹین اور ریشہ شامل کرنے سے خون میں شکر زیادہ ٹھہری رہتی ہے اور خواہش نرم پڑ جاتی ہے۔ نمک کم اور پانی زیادہ اپھارے میں کمی لا سکتا ہے۔ میگنیشیم سے بھرپور غذائیں (بادام، اخروٹ، گہری ہری سبزیاں، ڈارک چاکلیٹ) کچھ لوگوں میں مروڑ اور تناؤ کم کرتی ہیں۔ کیفین گھٹانا اِس مرحلے کی ٹوٹی نیند میں مدد دیتا ہے۔",
  "tipNutritionDetailUnknown": "مرحلہ کوئی بھی ہو، مدد وہی چیزیں دیتی ہیں: باقاعدہ کھانا، مناسب پروٹین، خوب سبزیاں، مناسب پانی، اور آئرن سے بھرپور غذائیں۔ چونکہ خون آنے سے آئرن کم ہوتا ہے، اُن دنوں تھوڑا زیادہ دھیان کافی ہے۔ چند سائیکل درج ہو جانے پر یہاں مرحلے کے مطابق تجاویز نظر آئیں گی۔",
  "tipSleepLabel": "نیند",
  "tipSleepMenstrual": "کھنچاؤ اور تکلیف نیند میں خلل ڈال سکتے ہیں؛ سونے سے پہلے گرم غسل یا ہیٹ پیڈ مدد کر سکتا ہے۔",
  "tipSleepFollicular": "توانائی بڑھنے کے ساتھ بہت سی خواتین زیادہ چاق چوبند محسوس کرتی ہیں — لیکن نیند کی اصل ضرورت واقعی کم نہیں ہوتی۔",
  "tipSleepFertile": "بیضہ دانی کے قریب جسمانی درجہ حرارت میں معمولی اضافہ نیند آنا تھوڑا مشکل بنا سکتا ہے؛ ٹھنڈا کمرہ مدد کر سکتا ہے۔",
  "tipSleepLuteal": "پروجیسٹرون آرام کا درجہ حرارت تھوڑا بڑھاتا ہے اور گہری نیند کو ہلکا کر سکتا ہے؛ ٹھنڈا، تاریک کمرہ اور باقاعدہ سونے کا وقت یہاں سب سے زیادہ مدد کرتا ہے۔",
  "tipSleepUnknown": "نیند کا معیار پورے سائیکل میں بدلتا رہتا ہے — عام طور پر ماہواری سے پہلے اور دوران سب سے نازک۔ مرحلہ کوئی بھی ہو، باقاعدہ سونے کا وقت سب سے قابل اعتماد بنیاد ہے۔",
  "tipSleepDetailMenstrual": "ماہواری کے دوران نیند اکثر زیادہ ٹوٹی پھوٹی ہوتی ہے — کھنچاؤ، تکلیف، اور کچھ کے لیے بار بار باتھ روم جانا رات میں جگا سکتا ہے۔ سونے سے پہلے گرم غسل، ہیٹ پیڈ یا ہلکی اسٹریچنگ کھنچاؤ کو کم کر سکتی ہے۔ اگر درد کی دوا لے رہی ہیں تو اس کا وقت اس طرح رکھنا کہ اثر رات کے پہلے حصے کو ڈھانپے، ابتدائی نیند کی حفاظت کر سکتا ہے۔",
  "tipSleepDetailFollicular": "اس مرحلے میں ایسٹروجن بڑھنے سے بہت سی خواتین زیادہ چاق چوبند اور توانا محسوس کرتی ہیں، جو کم نیند کی ضرورت جیسا لگ سکتا ہے۔ یہ بالکل درست نہیں — بس جاگتے رہنا آسان لگتا ہے۔ یہاں باقاعدہ سونے کا وقت برقرار رکھنا بعد میں فائدہ دیتا ہے جب دوسرے مراحل میں نیند زیادہ نازک ہو جاتی ہے۔",
  "tipSleepDetailFertile": "بیضہ دانی کے قریب جسمانی درجہ حرارت میں معمولی اضافہ نیند آنا تھوڑا مشکل بنا سکتا ہے، کیونکہ جسم قدرتی طور پر سونے سے پہلے ٹھنڈا ہونا چاہتا ہے۔ ٹھنڈا کمرہ، ہلکا کمبل یا سونے سے پہلے گرم غسل اس کی تلافی کر سکتا ہے۔",
  "tipSleepDetailLuteal": "بیضہ دانی کے بعد بڑھنے والا پروجیسٹرون آرام کا درجہ حرارت تھوڑا بڑھاتا ہے، جو گہری نیند کو ہلکا کر سکتا ہے — کبھی ہلکی گرمی کی لہر جیسا، کبھی صرف کم تازگی بخش نیند جیسا۔ ماہواری قریب آنے پر ماہواری سے پہلے کی کشیدگی بھی شامل ہو سکتی ہے۔ ٹھنڈا، تاریک کمرہ، سونے سے پہلے کم اسکرین وقت اور باقاعدہ سونے کا وقت یہاں سب سے زیادہ مدد کرتا ہے۔",
  "tipSleepDetailUnknown": "ابھی موجودہ مرحلہ بتانے کے لیے کافی ڈیٹا نہیں ہے، لیکن سائیکل میں نیند کے معیار کا بدلنا ایک عام طرزِ عمل ہے — عام طور پر ماہواری سے پہلے اور دوران زیادہ نازک، پہلے نصف میں زیادہ مستحکم۔ مرحلہ کوئی بھی ہو سب سے قابل اعتماد بنیاد: باقاعدہ سونے جاگنے کا وقت، سونے سے پہلے کم اسکرین وقت، اور ٹھنڈا، تاریک کمرہ۔"
}
