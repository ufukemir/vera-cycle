<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ replacement for allowBackup/fullBackupContent. Both transfer paths
  are refused outright rather than filtered: the cycle diary must not reach
  Google Drive, and it must not stream to a new phone during device-to-device
  setup either. See the comment on <application> in AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
