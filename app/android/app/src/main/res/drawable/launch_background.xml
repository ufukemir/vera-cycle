<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand cream, not white: see values/colors.xml. Deliberately a flat
         colour with no logo — the app draws its own first frame within a
         few hundred milliseconds, and a splash logo that appears and
         instantly vanishes reads as a flicker rather than as branding. -->
    <item android:drawable="@color/splash_background" />
</layer-list>
